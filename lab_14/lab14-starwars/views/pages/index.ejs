<!DOCTYPE html>
<html>

<head>
  <%- include('../partials/head') %>
</head>

<body class="container">
  <header>
    <%- include('../partials/header') %>
</header>

  <main>
    <div class="jumbotron">

      <h2>Quotes!</h2>
      <div>
        <% quotesarray.forEach(function(quote) { %>
        <div>
          <h3><%= quote.name %></h3>
          <p><%= quote.quote %></p>
        </div>
      <% }); %>
      </div>
    </div>
  </main>


  <footer>
    <p class="text-center text-muted">© Copyright 2018 Some People</p>
  </footer>

</body>

</html>
